# Copy this file to .env and fill it in. Never upload .env anywhere.
ONECLICK_JWT=paste-your-api-key-here
MERCHANT_NEAR_ACCOUNT=yourname.near
# Neon Postgres connection string (Vercel adds this for you when you connect Neon)
DATABASE_URL=
# Optional: your fee on each payment, in basis points (100 = 1%), and where it is paid
FEE_BPS=
FEE_RECIPIENT=
# Optional, off by default: NFT receipts through a Mintbase store
MINTBASE_STORE=
MINTER_ACCOUNT=
MINTER_KEY=
